# Connexion MariaDB (utilisée par Prisma et l'application)
DATABASE_URL="mysql://cours:cours@localhost:3307/cours"

# Better Auth — secret de 32+ caractères : `openssl rand -base64 32`
BETTER_AUTH_SECRET="change-me-with-a-long-random-string"
# URL publique de l'application (sans slash final)
BETTER_AUTH_URL="http://localhost:3000"

# Optionnel : restreindre l'inscription à certains domaines e-mail (séparés par des virgules)
# ex. "univ-exemple.fr,etu.univ-exemple.fr" — vide = inscription ouverte
SIGNUP_ALLOWED_DOMAINS=""

# Variables utilisées par docker-compose pour MariaDB
MARIADB_ROOT_PASSWORD="root-change-me"
MARIADB_DATABASE="cours"
MARIADB_USER="cours"
MARIADB_PASSWORD="cours"
# Port local de MariaDB (3306 souvent déjà pris par un MySQL installé)
DB_PORT=3307

# Vérificateur de liens : hôtes internes autorisés (ex. GitLab de l'IUT sur le réseau interne), séparés par des virgules
LINK_CHECK_ALLOW_HOSTS=""
# Instances PeerTube / Esup-Pod autorisées pour les intégrations vidéo (ex. "pod.univ-exemple.fr")
PEERTUBE_HOSTS=""

# --- Authentification externe (PAS ENCORE ACTIVE — voir docs/AUTH-EXTERNE.md) ---
# AUTH_PROVIDERS="credentials"          # "credentials,oidc" | "credentials,cas"
# CAS_BASE_URL="https://cas.univ-exemple.fr/cas"
# OIDC_PROVIDER_ID="univ"               # callback : ${BETTER_AUTH_URL}/api/auth/callback/univ
# OIDC_DISCOVERY_URL="https://cas.univ-exemple.fr/cas/oidc/.well-known/openid-configuration"
# OIDC_CLIENT_ID=""
# OIDC_CLIENT_SECRET=""
